+// jumpfix thresholds (MT2 units: X 0..8134, Y 0..5206)
+#define JUMPFIX_MIN_DIST       1200   // ~15% of pad width in one report
+#define JUMPFIX_MAX_SPEED_UPMS 80     // faster than this (units per ms) is not a real finger
+
+// Real Magic Trackpad 2 hands out a fresh identifier for every new contact.
+// Reusing the same one for a quick lift + re-touch lets macOS glue both strokes.
+UInt8 VoodooInputSimulatorDevice::allocIdent(UInt16 slot) {
+    for (int tries = 0; tries < 15; tries++) {
+        next_ident = (next_ident % 15) + 1;
+        bool used = false;
+        for (int s = 0; s < 15; s++)
+            if (s != slot && touch_active[s] && slot_ident[s] == next_ident) { used = true; break; }
+        if (!used) return next_ident;
+    }
+    return (UInt8)(slot + 1);
+}
