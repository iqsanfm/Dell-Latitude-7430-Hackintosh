+/*
+ * [dwt] Port of libinput tp_keyboard_event(): only real typing keys arm the
+ * timer; modifiers (incl. Tab/Caps Lock) never do and, while held, keep the
+ * next key from arming it (Cmd+C, Ctrl+click). F-keys, arrows, navigation,
+ * keypad and media keys are ignored (libinput: keycode >= KEY_F1).
+ * Keys are macOS/ADB virtual key codes as sent by VoodooPS2Keyboard.
+ */
+static int dwtModBit(UInt16 code) {
+    switch (code) {
+        case 0x30: return 0;  // tab
+        case 0x36: return 1;  // right command
+        case 0x37: return 2;  // command
+        case 0x38: return 3;  // shift
+        case 0x39: return 4;  // caps lock
+        case 0x3a: return 5;  // option
+        case 0x3b: return 6;  // control
+        case 0x3c: return 7;  // right shift
+        case 0x3d: return 8;  // right option
+        case 0x3e: return 9;  // right control
+        case 0x3f: return 10; // fn
+        default: return -1;
+    }
+}
+
+static bool dwtIsTypingKey(UInt16 code) {
+    return code < 0x30 || code == 0x31 || code == 0x32 || code == 0x33 || code == 0x35;
+}
+
+void RMITrackpadFunction::dwtKey(const RMIPS2KeyInfo *info) {
+    int bit = dwtModBit(info->adbKeyCode);
+    if (bit >= 0) {
+        if (info->goingDown) dwtModMask |= (1 << bit);
+        else dwtModMask &= ~(1 << bit);
+        return;
+    }
+    if (!info->goingDown || !dwtEnabled || !dwtIsTypingKey(info->adbKeyCode))
+        return;
+
+    uint64_t now = info->time;
+    UInt32 timeout;
+    if (now >= dwtExpire) {
+        if (dwtModMask)             // shortcut, not typing
+            return;
+        timeout = dwtTimeout1;
+        dwtTriggers++;
+    } else {
+        timeout = dwtTimeout2;
+    }
+    dwtLastPress = now;
+    dwtExpire = now + (uint64_t) timeout * MILLI_TO_NANO;
+}
+
+void RMITrackpadFunction::dwtPublish() {
+    dwtDirty = false;
+    OSDictionary *d = OSDictionary::withCapacity(8);
+    if (!d) return;
+    auto put = [d](const char *k, UInt64 v) {
+        OSNumber *n = OSNumber::withNumber(v, 32);
+        if (n) { d->setObject(k, n); n->release(); }
+    };
+    d->setObject("Enabled", dwtEnabled ? kOSBooleanTrue : kOSBooleanFalse);
+    put("Timeout1", dwtTimeout1);
+    put("Timeout2", dwtTimeout2);
+    put("ReleaseMove", dwtReleaseMove);
+    put("Triggers", dwtTriggers);
+    put("Blocked", dwtBlocked);
+    put("Released", dwtReleased);
+    put("LastBlockMsAfterKey", dwtLastBlockMs);
+    setProperty("DWT", d);
+    d->release();
+}
+
+// [dwt] runtime tuning: {"DWTEnabled"=bool, "DWTTimeout1"=ms, "DWTTimeout2"=ms, "DWTReleaseMove"=per-mille}
+IOReturn RMITrackpadFunction::setProperties(OSObject *properties) {
+    OSDictionary *dict = OSDynamicCast(OSDictionary, properties);
+    if (!dict) return kIOReturnBadArgument;
+    bool any = false;
+    if (OSBoolean *b = OSDynamicCast(OSBoolean, dict->getObject("DWTEnabled"))) { dwtEnabled = b->isTrue(); any = true; }
+    if (OSNumber *n = OSDynamicCast(OSNumber, dict->getObject("DWTTimeout1"))) { if (n->unsigned32BitValue() <= 5000) dwtTimeout1 = n->unsigned32BitValue(); any = true; }
+    if (OSNumber *n = OSDynamicCast(OSNumber, dict->getObject("DWTTimeout2"))) { if (n->unsigned32BitValue() <= 5000) dwtTimeout2 = n->unsigned32BitValue(); any = true; }
+    if (OSNumber *n = OSDynamicCast(OSNumber, dict->getObject("DWTReleaseMove"))) { if (n->unsigned32BitValue() <= 1000) dwtReleaseMove = n->unsigned32BitValue(); any = true; }
+    if (!any) return kIOReturnUnsupported;
+    if (!dwtEnabled) dwtExpire = 0;
+    dwtDirty = true;
+    return kIOReturnSuccess;
+}
